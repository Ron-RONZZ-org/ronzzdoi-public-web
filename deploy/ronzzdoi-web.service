[Unit]
Description=ronzzdoi public web frontend
After=network.target

[Service]
Type=simple
User=ronzz
Group=ronzz
WorkingDirectory=/opt/ronzzdoi-public-web
EnvironmentFile=/opt/ronzzdoi-public-web/.env
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
