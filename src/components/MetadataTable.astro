---
export interface Props {
  metadata: Record<string, unknown>;
}

/**
 * Renders a DOI record's metadata as a key-value table.
 * Filters out empty values and formats common field names.
 */

const LABEL_MAP: Record<string, string> = {
  authors: "Authors",
  creators: "Creators",
  presenters: "Presenters",
  directors: "Directors",
  hosts: "Hosts",
  artists: "Artists",
  title: "Title",
  publisher: "Publisher",
  publication: "Publication",
  conference_name: "Conference",
  event_name: "Event",
  website_name: "Website",
  newspaper_name: "Newspaper",
  magazine_name: "Magazine",
  podcast_name: "Podcast",
  studio: "Studio",
  label: "Label",
  institution: "Institution",
  repository: "Repository",
  year: "Year",
  date: "Date",
  access_date: "Access Date",
  publication_date: "Publication Date",
  isbn: "ISBN",
  edition: "Edition",
  volume: "Volume",
  issue: "Issue",
  pages: "Pages",
  doi: "DOI",
  archive: "Archive",
  url: "URL",
  version: "Version",
  duration: "Duration",
  format: "Format",
  album: "Album",
  episode_number: "Episode #",
  episode_title: "Episode Title",
  location: "Location",
  report_number: "Report #",
  book_doi: "Parent Book",
  ciruclaire_number: "Circulaire #",
  issuing_authority_doi: "Issuing Authority",
  description: "Description",
  subtype: "Subtype",
  first_name: "First Name",
  last_name: "Last Name",
  legal_name: "Legal Name",
  iso_code: "ISO Code",
};

function formatValue(value: unknown): string {
  if (value === null || value === undefined || value === "") return "";
  if (typeof value === "string") return value;
  if (typeof value === "number") return String(value);
  if (Array.isArray(value)) {
    return value
      .map((v) => {
        if (typeof v === "object" && v !== null) {
          const obj = v as Record<string, unknown>;
          if (obj.person_doi) return obj.person_doi as string;
          if (obj.given || obj.family) return [obj.given, obj.family].filter(Boolean).join(" ");
          return JSON.stringify(v);
        }
        return String(v);
      })
      .join("; ");
  }
  return JSON.stringify(value);
}

const entries = Object.entries(Astro.props.metadata).filter(
  ([, v]) => v !== null && v !== undefined && v !== "",
);
---

{entries.length > 0 && (
  <table class="w-full text-left text-sm">
    <tbody>
      {entries.map(([key, value]) => {
        const label = LABEL_MAP[key] ?? key.replace(/_/g, " ");
        const formatted = formatValue(value);
        if (!formatted) return null;
        return (
          <tr class="border-b border-gray-100 last:border-0">
            <th class="w-1/3 py-2 pr-4 font-medium text-gray-500" scope="row">
              {label}
            </th>
            <td class="py-2 text-gray-900">{formatted}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
)}
