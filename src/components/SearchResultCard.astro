---
import type { PublicDOIResponse } from "../lib/types";

export interface Props {
  item: PublicDOIResponse;
}

const { item } = Astro.props;
const doiSuffix = item.doi.replace(/^10\.ronzz\//, "");
---

<a
  href={`/doi/${encodeURIComponent(doiSuffix)}`}
  class="block rounded-lg border border-gray-200 p-4 transition hover:border-blue-300 hover:shadow-sm"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <h3 class="text-lg font-semibold text-gray-900">
        {item.title || "Untitled"}
      </h3>
      <p class="mt-1 text-sm text-gray-500">{item.doi}</p>

      {item.snippet && (
        <p class="mt-2 text-sm text-gray-700 [&_mark]:rounded [&_mark]:bg-yellow-200 [&_mark]:px-0.5">
          {item.snippet}
        </p>
      )}
    </div>

    <span class="shrink-0 rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
      {item.doi_type}
    </span>
  </div>
</a>
