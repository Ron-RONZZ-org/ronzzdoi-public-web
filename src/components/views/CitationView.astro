---
import type { PublicDOIResponse } from "../../lib/types";
import MetadataTable from "../MetadataTable.astro";
import CitationPreview from "../CitationPreview.astro";

export interface Props {
  record: PublicDOIResponse;
  citations: Array<{ style: string; citation: string }>;
}
---

<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-900">{record.title || record.doi}</h1>

  {record.target_url && (
    <a
      href={record.target_url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
    >
      Visit Resource
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  )}

  <section>
    <h2 class="mb-3 text-lg font-semibold text-gray-800">Citation</h2>
    <CitationPreview citations={citations} />
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold text-gray-800">Metadata</h2>
    <MetadataTable metadata={record.metadata} />
  </section>
</div>
