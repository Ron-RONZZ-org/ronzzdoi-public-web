---
// ─── Embed fragment page — https://doi.ronzz.org/embed/10.ronzz/<suffix>
//
// Self-contained HTML fragment designed to be framed by other ronzz sites
// via an <iframe>.  NO Base layout — no site chrome, no scripts, no
// Tailwind.  Every content path escapes input (see lib/snippetEmbed.ts).
//
// Options (query params):
//   ?theme=dark     — dark rendering (shiki theme + background)
//   ?cite=0         — hide title + attribution footer
//   ?title=<text>   — override the <title> (escaped)
//
// Headers set here:
//   Cross-Origin-Resource-Policy: cross-origin   (frameable cross-site)
//   Content-Security-Policy: frame-ancestors *   (framing policy)
//   Cache-Control: public, max-age=60, s-maxage=300  (edits propagate ≤5 min)

import "katex/dist/katex.min.css";
import type { PublicSnippetResponse } from "../../lib/types";
import { fetchSnippet } from "../../lib/api";
import { ApiError, GoneError, NotFoundError } from "../../lib/errors";
import { renderSnippetContent, snippetAttribution, escapeHtml } from "../../lib/snippetEmbed";

const raw = Astro.params.doi ?? "";
const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";
const cite = Astro.url.searchParams.get("cite") !== "0";
const titleOverride = Astro.url.searchParams.get("title") ?? "";

// Embed pages must be frameable by other ronzz sites (nginx strips the
// global X-Frame-Options DENY for /embed/ — see deploy/ronzzdoi-web.nginx.conf).
Astro.response.headers.set("Cross-Origin-Resource-Policy", "cross-origin");
Astro.response.headers.set(
  "Content-Security-Policy",
  "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'",
);
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300");

let snippet: PublicSnippetResponse | null = null;
let contentHtml = "";
let attribution: { text: string; href: string | null } = { text: "", href: null };
let attributionHtml = "";
let error: { status: number; message: string } | null = null;

if (!raw.startsWith("10.ronzz/")) {
  error = { status: 404, message: "Invalid DOI." };
  Astro.response.status = 404;
} else {
  try {
    snippet = await fetchSnippet(raw);
    contentHtml = await renderSnippetContent(snippet, theme);
    attribution = snippetAttribution(snippet);
    // attribution.text is already escaped by snippetAttribution; escape the href too.
    if (attribution.text) {
      attributionHtml = attribution.href
        ? `<a href="${escapeHtml(attribution.href)}">${attribution.text}</a>`
        : attribution.text;
    }
  } catch (e: unknown) {
    if (e instanceof GoneError) {
      error = { status: 410, message: "This snippet has been deleted." };
      Astro.response.status = 410;
    } else if (e instanceof NotFoundError) {
      error = { status: 404, message: "Snippet not found." };
      Astro.response.status = 404;
    } else if (e instanceof ApiError) {
      error = { status: e.status, message: e.message };
      Astro.response.status = e.status;
    } else {
      error = { status: 500, message: "Could not load this snippet." };
      Astro.response.status = 500;
    }
  }
}

const pageTitle = titleOverride || snippet?.title || snippet?.doi || "ronzzdoi snippet";
const doiSuffix = snippet?.doi.replace(/^10\.ronzz\//, "") ?? "";
const doiHref = `/doi/${encodeURIComponent(doiSuffix)}`;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    {error ? (
      <main class="snip-error" data-status={error.status}>
        <p>{error.message}</p>
      </main>
    ) : snippet ? (
      <main class="snip-embed">
        {cite && snippet.title && (
          <header class="snip-header">
            <h1>{snippet.title}</h1>
          </header>
        )}

        <div class="snip-content" data-kind={snippet.content_kind} set:html={contentHtml} />

        {cite && attributionHtml && (
          <footer class="snip-attr" set:html={attributionHtml} />
        )}

        <footer class="snip-doi">
          <a href={doiHref}>DOI {escapeHtml(snippet.doi)}</a>
        </footer>
      </main>
    ) : null}
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }
  html[data-theme="dark"] {
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #fafafa;
    color: #1f2937;
    padding: 0.75rem;
  }
  html[data-theme="dark"] body {
    background: #16161f;
    color: #e5e7eb;
  }
  .snip-embed {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .snip-header h1 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .snip-content {
    overflow-x: auto;
  }
  .snip-quote {
    margin: 0;
    padding-left: 0.6rem;
    border-left: 3px solid #3b82f6;
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.55;
    word-break: break-word;
  }
  .snip-quote > :first-child { margin-top: 0; }
  .snip-quote > :last-child { margin-bottom: 0; }
  .snip-quote p { margin: 0.5rem 0; }
  .snip-quote blockquote {
    margin: 0.5rem 0;
    padding-left: 0.6rem;
    border-left: 2px solid #93c5fd;
  }
  .snip-quote ul,
  .snip-quote ol { margin: 0.5rem 0; padding-left: 1.4rem; }
  .snip-quote li { margin: 0.2rem 0; }
  .snip-quote h1,
  .snip-quote h2,
  .snip-quote h3,
  .snip-quote h4 { margin: 0.75rem 0 0.4rem; font-size: 1.05rem; }
  .snip-quote a { color: #2563eb; text-decoration: none; }
  .snip-quote a:hover { text-decoration: underline; }
  .snip-quote code {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
  }
  .snip-quote pre {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 0.5rem 0.6rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
    font-style: normal;
    white-space: pre-wrap;
  }
  .snip-quote pre code { background: none; border: none; padding: 0; }
  html[data-theme="dark"] .snip-quote code,
  html[data-theme="dark"] .snip-quote pre {
    background: #1e1e2a;
    border-color: #2f2f3f;
  }
  .snip-quote hr { border: none; border-top: 1px solid #e5e7eb; margin: 0.75rem 0; }
  .snip-content pre {
    margin: 0;
    border-radius: 6px;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .snip-content .snip-math {
    overflow-x: auto;
    padding: 0.25rem 0;
  }
  .snip-code-fallback,
  .snip-math-fallback {
    padding: 0.5rem 0.6rem;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  html[data-theme="dark"] .snip-code-fallback,
  html[data-theme="dark"] .snip-math-fallback {
    background: #1e1e2a;
    border-color: #2f2f3f;
  }
  .snip-attr {
    font-size: 0.72rem;
    color: #6b7280;
  }
  html[data-theme="dark"] .snip-attr {
    color: #9ca3af;
  }
  .snip-attr a,
  .snip-doi a {
    color: #2563eb;
    text-decoration: none;
  }
  .snip-attr a:hover,
  .snip-doi a:hover {
    text-decoration: underline;
  }
  html[data-theme="dark"] .snip-attr a,
  html[data-theme="dark"] .snip-doi a {
    color: #60a5fa;
  }
  .snip-doi {
    font-size: 0.68rem;
    opacity: 0.8;
  }
  .snip-error {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    font-size: 0.85rem;
    color: #6b7280;
  }
</style>
